# 复制本文件为 .deploy.env，填入自己的服务器信息（.deploy.env 不要提交/外传）
# 用法：cp .deploy.env.example .deploy.env && vi .deploy.env

# SSH 登录目标（用户名@IP 或 SSH 别名）
SERVER=ubuntu@82.157.190.184

# 服务器上的项目目录（需已存在，且已装好 docker + docker compose）
REMOTE_DIR=/home/ubuntu/BookHealth

# 可选：SSH 端口（写在 SERVER 里也行，例如 ubuntu@1.2.3.4:2222 需改脚本，建议直接用 ~/.ssh/config 别名）
