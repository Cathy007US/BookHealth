# ============================================================
# BookHealth 唯一配置文件
# 服务器：/home/ubuntu/BookHealth/bookhealth-api.env
# 本地  ：项目根目录 bookhealth-api.env
#
# 改完执行（任选其一）：
#   本地：  ./scripts/deploy.sh config
#   服务器：cd /home/ubuntu/BookHealth && docker compose up -d --force-recreate backend
#
# 这个文件同时供三个容器使用：
#   db      ← POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD
#   backend ← DB_NAME / DB_USER / DB_PASSWORD + JWT + 登录账号
#   frontend 不用
# ============================================================

# ---------- 后台管理登录（/admin） ----------
# 改这两行 = 改后台登录账号密码，不需要动数据库
ADMIN_USER=test01
ADMIN_PASS=admin123456

# ---------- 前台用户登录（/login） ----------
# 改这两行 = 改前台登录账号密码，不需要动数据库
APP_USER=test01
APP_PASS=123456

# ---------- 数据库 ----------
# DB_*        后端连库用（容器里由本文件注入）
# POSTGRES_*  postgres 官方镜像初始化用（建库/建超级用户/设密码）
# 两组必须保持一致，否则会「连接成功但认证失败」→ 接口 502。
# ./scripts/deploy.sh config 会先校验一致性，再自动改库内密码、改名，最后重启容器。
#
# 注意：POSTGRES_* 只在数据卷「首次初始化」时生效。
# 之后改密码不会自动改库内密码，必须走 deploy.sh config（内部执行 ALTER USER）；
# 改库名会执行 ALTER DATABASE ... RENAME。
DB_NAME=bookhealth
DB_USER=postgres
DB_PASSWORD=postgres123

POSTGRES_DB=bookhealth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# ---------- JWT ----------
# 改 JWT_SECRET = 所有人重新登录；改 ADMIN_JWT_SECRET = 后台重新登录
JWT_SECRET=bookhealth_jwt_secret_key_2026
ADMIN_JWT_SECRET=bookhealth_admin_jwt_secret_2026
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=24h
