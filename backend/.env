PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bookhealth
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=bookhealth_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# Admin JWT
ADMIN_JWT_SECRET=bookhealth_admin_jwt_secret_2026
