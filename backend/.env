# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# SMS (placeholder)
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY=your_access_key
SMS_SECRET_KEY=your_secret_key
SMS_SIGN_NAME=BookHealth
SMS_TEMPLATE_CODE=SMS_000001

# WeChat
WX_APPID=your_appid
WX_SECRET=your_secret
